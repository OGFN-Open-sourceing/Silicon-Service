---
import Panel from "../layouts/Panel.astro";
import Icon from "../components/Icon.astro";
---
<Panel title="Accounts" tab="accounts">
  <form class="card card-body row" id="search">
    <div class="search"><Icon name="search" /><input name="q" placeholder="Search by name, email or account id" autocomplete="off" /></div>
    <button>Search</button>
  </form>
  <div class="card" id="results"><div class="card-body"><div class="skeleton"></div></div></div>
</Panel>
<script>
  import { $, backend, esc, table, person, empty, failed, ago, when, loading } from "../lib/core";
  import { openAccount, flags } from "../lib/account";

  type Account = { accountId: string; displayName: string; email: string; created: number; lastLogin: number; banned: boolean; banReason: string; founder: boolean; host: boolean; online: boolean };
  const form = $<HTMLFormElement>("#search");
  let query = "";

  async function load() {
    $("#results").innerHTML = loading(3);
    try {
      const { accounts = [] } = await backend<{ accounts: Account[] }>("GET", "/accounts?q=" + encodeURIComponent(query));
      const title = query ? `${accounts.length} result${accounts.length === 1 ? "" : "s"} for "${esc(query)}"` : "Recently active";
      $("#results").innerHTML =
        `<div class="card-head"><h2>${title}</h2><span class="muted">click an account for details</span></div>` +
        table(
          ["Account", "Email", "Created", "Last login", "Status"],
          accounts.map((a) => [
            `<div data-open="${esc(a.accountId)}" style="cursor:pointer">${person(a.displayName, a.accountId)}</div>`,
            `<span class="muted mono">${esc(a.email || "-")}</span>`,
            `<span class="muted">${esc(when(a.created))}</span>`,
            `<span title="${esc(when(a.lastLogin))}">${esc(ago(a.lastLogin))}</span>`,
            `<div class="chips">${flags(a) || '<span class="pill plain">Active</span>'}</div>`,
          ]),
          empty("search", query ? `No account matches "${query}".` : "No accounts yet."),
        );
      $("#results").querySelectorAll<HTMLElement>("tbody tr").forEach((tr) => {
        const id = tr.querySelector<HTMLElement>("[data-open]")?.dataset.open;
        if (!id) return;
        tr.style.cursor = "pointer";
        tr.addEventListener("click", () => openAccount(id, load));
      });
    } catch (err) {
      $("#results").innerHTML = `<div class="card-body">${failed(err)}</div>`;
    }
  }

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    query = String(new FormData(form).get("q") ?? "").trim();
    load();
  });
  load();
</script>
